# Copy this file to ".env" and fill in your key(s). Never commit ".env".
#
# --- Default: Groq (free, fast) — reads the photo + writes the lesson ---
# Free key from https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_TEXT_MODEL=llama-3.3-70b-versatile
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Optional alternatives (see agents/ for wiring) ---
# Claude (best accuracy; needs Anthropic account credits):
#   ANTHROPIC_API_KEY=sk-ant-...
#   CLAUDE_MODEL=claude-haiku-4-5-20251001
# Local Ollama (free/offline; slower on CPU):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_TEXT_MODEL=qwen2.5:3b
#   LLM_VISION_MODEL=moondream

# Disable step images (show a placeholder instead):
# IMAGES_ENABLED=0
